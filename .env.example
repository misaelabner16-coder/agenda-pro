NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua-chave-publica
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only Supabase secret key. Configure ONLY on the matching environment.
# Never prefix with NEXT_PUBLIC_ and never paste the value in chat/logs.
SUPABASE_SECRET_KEY=
# Local gateway testing is opt-in; ignored on Vercel. Keep unset in normal use.
# SECURITY_LOCAL_BOOKING_TEST=1
# Explicit, temporary local access to the São Paulo production database (tests only).
# Preview must always have its own database; this flag never bypasses preview isolation.
# ALLOW_PRODUCTION_DATABASE_FOR_TESTS=1
